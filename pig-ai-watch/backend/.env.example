# Environment
DEBUG=True
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pig_ai_watch
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/pig_ai_watch
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32

# YOLO
YOLO_WEIGHTS_PATH=models/pig_detection.pt
YOLO_CONFIDENCE_THRESHOLD=0.5

# Alert thresholds
CRUSHING_RISK_THRESHOLD=0.7
PIGLET_PROXIMITY_THRESHOLD=50

# ====================================
# IP CAMERA / CCTV CONFIGURATION
# ====================================
# Configure your wireless IP cameras or CCTV systems here.
# Leave blank or comment out for demo mode.
# Use "0", "1", "2" etc. for USB cameras.

# Camera Connection Settings
CAMERA_BUFFER_SIZE=1                # Minimize latency (1-3 recommended)
CAMERA_OPEN_TIMEOUT_MS=10000        # 10 seconds to open connection
CAMERA_READ_TIMEOUT_MS=5000         # 5 seconds to read frame
CAMERA_RECONNECT_ATTEMPTS=3         # Number of reconnection attempts
CAMERA_RECONNECT_DELAY_SEC=2        # Delay between reconnection attempts

# Camera Sources - Choose your configuration method:

# METHOD 1: RTSP IP Cameras (Most Common)
# Format: rtsp://username:password@IP_ADDRESS:PORT/path
# CAMERA_PEN_1=rtsp://admin:password123@192.168.1.100:554/stream1
# CAMERA_PEN_2=rtsp://admin:password123@192.168.1.101:554/stream1
# CAMERA_PEN_3=rtsp://admin:password123@192.168.1.102:554/stream1

# METHOD 2: HTTP/MJPEG IP Cameras
# CAMERA_PEN_1=http://192.168.1.100:8080/video
# CAMERA_PEN_2=http://username:password@192.168.1.101/mjpg/video.mjpg

# METHOD 3: USB Cameras (use device index)
# CAMERA_PEN_1=0
# CAMERA_PEN_2=1
# CAMERA_PEN_3=2

# METHOD 4: Mixed Configuration
# CAMERA_PEN_1=rtsp://admin:admin123@192.168.1.100:554/stream1
# CAMERA_PEN_2=0
# CAMERA_PEN_3=http://192.168.1.102:8080/video

# Common IP Camera Brands URL Formats:
# -----------------------------------
# Hikvision:  rtsp://username:password@IP:554/Streaming/Channels/101
# Dahua:      rtsp://username:password@IP:554/cam/realmonitor?channel=1&subtype=0
# Axis:       rtsp://username:password@IP/axis-media/media.amp
# Foscam:     rtsp://username:password@IP:554/videoMain
# TP-Link:    rtsp://username:password@IP:554/stream1
# Reolink:    rtsp://username:password@IP:554/h264Preview_01_main
# Amcrest:    rtsp://username:password@IP:554/cam/realmonitor?channel=1&subtype=0

# Examples - Uncomment and modify:
# CAMERA_PEN_1=rtsp://admin:admin123@192.168.1.100:554/stream1
# CAMERA_PEN_2=rtsp://admin:admin123@192.168.1.101:554/stream1
# CAMERA_PEN_3=rtsp://admin:admin123@192.168.1.102:554/stream1
# CAMERA_PEN_4=rtsp://admin:admin123@192.168.1.103:554/stream1
# CAMERA_PEN_5=rtsp://admin:admin123@192.168.1.104:554/stream1


# LLM Summarization API (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here

# LLM + Push Notifications
ANTHROPIC_API_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Cloudinary (optional): store replay/event clips in cloud media storage
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=pig-ai-watch
# CLOUDINARY_SECURE=true
