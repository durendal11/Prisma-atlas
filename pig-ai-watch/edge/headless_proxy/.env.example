# === Prisma Atlas Edge Proxy Config ===
CLOUD_IP=prisma-atlas.duckdns.org
CLOUD_RTSP_PORT=8554
PUBLISH_RETRY_SEC=5
TCP_CHECK_TIMEOUT_SEC=5
EDGE_PUBLISH_CONFIG_REFRESH_SEC=30
EDGE_PUBLISH_FAIL_FAST_SEC=12
EDGE_PUBLISH_TRY_STREAM2=true
EDGE_PUBLISH_PREFER_STREAM2=true
EDGE_PUBLISH_ROTATE_SOURCE_ON_DISCONNECT=true
EDGE_PUBLISH_THREAD_QUEUE_SIZE=64
EDGE_PUBLISH_FORCE_RE=false

# Cloud-driven camera mapping mode (recommended)
# When CLOUD_API_URL and EDGE_API_KEY are set and no FARM_CAM_x vars exist,
# edge_pusher.py will auto-pull local camera URLs + stream paths from cloud.
CLOUD_API_URL=https://prisma-atlas.duckdns.org
EDGE_API_KEY=replace-with-edge-api-key

# Legacy static mode (optional fallback)
# If FARM_CAM_x exists, the script uses these values and skips cloud mapping.
# The number at the end becomes the path. (e.g. FARM_CAM_1 -> pen_1)
# FARM_CAM_1=rtsp://username:password@192.168.1.100:554/stream1
# FARM_CAM_2=rtsp://username:password@192.168.1.101:554/stream1