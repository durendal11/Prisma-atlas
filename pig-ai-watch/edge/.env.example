# ════════════════════════════════════════════════════════════════
#  PRISMA ATLAS — Edge Agent  •  Environment Variables
#  Copy this file to .env and edit:
#    cp .env.example .env
# ════════════════════════════════════════════════════════════════

# ── Cloud Server ───────────────────────────────────────────────
CLOUD_API_URL=https://your-app.ondigitalocean.app
EDGE_API_KEY=change-me-to-a-long-random-string

# ── AI Model ───────────────────────────────────────────────────
MODEL_PATH=models/pig_detection.onnx

# ── Cameras (RTSP URLs per pen) ────────────────────────────────
# Map each pen to a camera.  Leave blank for pens without cameras.
CAMERA_PEN_1=rtsp://admin:password@192.168.1.100:554/stream
CAMERA_PEN_2=rtsp://admin:password@192.168.1.101:554/stream
# CAMERA_PEN_3=rtsp://admin:password@192.168.1.102:554/stream

# ── Inference Timing ───────────────────────────────────────────
INFERENCE_INTERVAL_SEC=2
SYNC_INTERVAL_SEC=30
BUFFER_PURGE_DAYS=7

# ── Frame Capture ──────────────────────────────────────────────
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FRAME_FPS=15
CONFIDENCE_THRESHOLD=0.5
