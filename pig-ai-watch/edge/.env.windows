# ════════════════════════════════════════════════════════════════
#  PRISMA ATLAS — Edge Agent  •  WINDOWS DEPLOYMENT
#  Copy this file to the Windows laptop as ".env" inside pig-ai-watch/edge/
# ════════════════════════════════════════════════════════════════

# ── Cloud Server ──────────────────────────────────────────────
# Backend running via Docker on Mac at 192.168.5.73
CLOUD_API_URL=http://192.168.5.73:8000
EDGE_API_KEY=test-key-local          # must match EDGE_API_KEY in backend .env

# ── AI Model ─────────────────────────────────────────────────
# On Windows the path must be relative to edge/ or an absolute Windows path.
# Copy pig_detection.pt alongside the edge/ folder:
#   e.g.  C:\pig-ai-watch\models\pig_detection.pt  → MODEL_PATH=../models/pig_detection.pt
#   or    C:\pig-ai-watch\edge\pig_detection.pt    → MODEL_PATH=pig_detection.pt
MODEL_PATH=../models/pig_detection.pt

# ── Cameras ──────────────────────────────────────────────────
# Tapo camera confirmed working at 192.168.5.192 (1280x720 @ 30fps)
CAMERA_PEN_1=rtsp://Tapoprisma:tapoprisma1@192.168.5.192:554/stream1

# Add more cameras for additional pens if available:
# CAMERA_PEN_2=rtsp://user:pass@<ip>:554/stream1

# ── Mock pens (mock_push.py only — not needed for real inference) ──
MOCK_PENS=pen-1,pen-2,pen-3

# ── Inference / timing ───────────────────────────────────────
INFERENCE_INTERVAL_SEC=2
SYNC_INTERVAL_SEC=30
BUFFER_PURGE_DAYS=7

# ── Frame capture ────────────────────────────────────────────
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FRAME_FPS=15
CONFIDENCE_THRESHOLD=0.5
