# ════════════════════════════════════════════════════════════════
#  PRISMA ATLAS — Pig AI Watch  •  Environment Variables
#  Copy this file to .env and edit as needed:
#    cp .env.example .env
# ════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pig_ai_watch
DB_PORT=5432

# ── Backend ────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# ── Frontend ───────────────────────────────────────────────────
FRONTEND_PORT=3000

# ── Camera sources (optional) ─────────────────────────────────
# Set RTSP URLs or USB camera indices for each pen.
# Leave blank for demo mode (synthetic frames).
# CAMERA_PEN_1=rtsp://admin:password@192.168.1.100:554/stream
# CAMERA_PEN_2=rtsp://admin:password@192.168.1.101:554/stream
# CAMERA_PEN_3=0          # USB camera index

# ── YOLO Model ─────────────────────────────────────────────────
YOLO_WEIGHTS_PATH=models/pig_detection.pt
YOLO_CONFIDENCE_THRESHOLD=0.5

# ── Edge Device (Raspberry Pi) ─────────────────────────────────
# Set a shared secret so the Pi can push detections to the cloud.
# Set LOCAL_CAMERAS_ENABLED=false when cameras are on the Pi, not the server.
EDGE_API_KEY=change-me-to-a-long-random-string
LOCAL_CAMERAS_ENABLED=true

# ── MediaMTX RTSP Proxy (optional) ────────────────────────────
MEDIAMTX_ENABLED=false
# MEDIAMTX_URL=rtsp://mediamtx:8554
# MEDIAMTX_API_URL=http://mediamtx:9997
